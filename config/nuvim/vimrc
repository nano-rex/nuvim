set nocompatible
filetype plugin indent on
syntax enable

set encoding=utf-8
set hidden
set number
set relativenumber
set signcolumn=yes
set cursorline
set splitbelow
set splitright
set updatetime=300
set timeoutlen=500
set wildmenu
set wildmode=longest:full,full
set completeopt=menuone,noinsert,noselect
set shortmess+=c
set termguicolors
set background=dark
set expandtab
set shiftwidth=4
set tabstop=4
set smartindent
set ignorecase
set smartcase
set incsearch
set hlsearch
set undofile
set undodir=~/.cache/nuvim/undo
set backupdir=~/.cache/nuvim/backup
set directory=~/.cache/nuvim/swap
set mouse=a
set clipboard=unnamedplus

let mapleader = " "

call mkdir(expand('~/.cache/nuvim/undo'), 'p')
call mkdir(expand('~/.cache/nuvim/backup'), 'p')
call mkdir(expand('~/.cache/nuvim/swap'), 'p')

packloadall
silent! helptags ALL

if exists('+termguicolors')
  set termguicolors
endif

silent! colorscheme onedark

let g:lightline = {
      \ 'colorscheme': 'onedark',
      \ }

let g:NERDTreeShowHidden = 1
let g:NERDTreeMinimalUI = 1
nnoremap <leader>e :NERDTreeToggle<CR>
nnoremap <leader>f :Files<CR>
nnoremap <leader>g :GFiles?<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>r :Rg<CR>
nnoremap <leader>w :write<CR>
nnoremap <leader>q :quit<CR>
nnoremap <leader>h :nohlsearch<CR>

let g:ale_fix_on_save = 1
let g:ale_completion_enabled = 0
let g:ale_linters_explicit = 0
let g:ale_fixers = {
      \ '*': ['remove_trailing_lines', 'trim_whitespace'],
      \ 'python': ['black', 'isort'],
      \ 'javascript': ['prettier'],
      \ 'typescript': ['prettier'],
      \ 'json': ['prettier'],
      \ 'css': ['prettier'],
      \ 'html': ['prettier'],
      \ 'go': ['gofmt'],
      \ 'rust': ['rustfmt'],
      \ 'sh': ['shfmt'],
      \ }

let g:asyncomplete_auto_popup = 1
let g:lsp_diagnostics_enabled = 1
let g:lsp_diagnostics_echo_cursor = 1
let g:lsp_document_code_action_signs_enabled = 1
let g:lsp_document_highlight_enabled = 1
let g:lsp_preview_float = 1

function! s:executable(name) abort
  return executable(a:name)
endfunction

function! s:register_lsp(name, cmd, allowlist) abort
  if s:executable(a:cmd[0])
    call lsp#register_server({
          \ 'name': a:name,
          \ 'cmd': {server_info -> a:cmd},
          \ 'allowlist': a:allowlist,
          \ })
  endif
endfunction

if exists('*lsp#register_server')
  call s:register_lsp('clangd', ['clangd'], ['c', 'cpp', 'objc', 'objcpp'])
  call s:register_lsp('rust-analyzer', ['rust-analyzer'], ['rust'])
  call s:register_lsp('gopls', ['gopls'], ['go'])
  call s:register_lsp('pyright', ['pyright-langserver', '--stdio'], ['python'])
  call s:register_lsp('typescript-language-server', ['typescript-language-server', '--stdio'], ['javascript', 'javascriptreact', 'typescript', 'typescriptreact'])
  call s:register_lsp('vscode-html-language-server', ['vscode-html-language-server', '--stdio'], ['html'])
  call s:register_lsp('vscode-css-language-server', ['vscode-css-language-server', '--stdio'], ['css', 'scss', 'less'])
  call s:register_lsp('vscode-json-language-server', ['vscode-json-language-server', '--stdio'], ['json'])
  call s:register_lsp('bash-language-server', ['bash-language-server', 'start'], ['sh'])
  call s:register_lsp('lua-language-server', ['lua-language-server'], ['lua'])
  call s:register_lsp('intelephense', ['intelephense', '--stdio'], ['php'])
  call s:register_lsp('solargraph', ['solargraph', 'stdio'], ['ruby'])
  call s:register_lsp('jdtls', ['jdtls'], ['java'])
  call s:register_lsp('kotlin-language-server', ['kotlin-language-server'], ['kotlin'])
  call s:register_lsp('dart', ['dart', 'language-server', '--protocol=lsp'], ['dart'])
  call s:register_lsp('yaml-language-server', ['yaml-language-server', '--stdio'], ['yaml'])
  call s:register_lsp('docker-langserver', ['docker-langserver', '--stdio'], ['dockerfile'])
  call s:register_lsp('marksman', ['marksman', 'server'], ['markdown'])
endif

imap <c-space> <Plug>(asyncomplete_force_refresh)
inoremap <expr> <CR> pumvisible() ? "\<C-y>" : "\<CR>"
nnoremap gd :LspDefinition<CR>
nnoremap gr :LspReferences<CR>
nnoremap gi :LspImplementation<CR>
nnoremap K :LspHover<CR>
nnoremap <leader>rn :LspRename<CR>
nnoremap <leader>ca :LspCodeAction<CR>
nnoremap [d :LspPreviousDiagnostic<CR>
nnoremap ]d :LspNextDiagnostic<CR>

if filereadable(expand('~/.config/nuvim/after.vim'))
  source ~/.config/nuvim/after.vim
endif
